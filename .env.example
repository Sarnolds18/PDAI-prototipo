# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local al repositorio (es público).

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "service_role" (secreta). Solo la usa el servidor; nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Firma las cookies de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET=

# Contraseña del dashboard /admin
ADMIN_PASSWORD=
