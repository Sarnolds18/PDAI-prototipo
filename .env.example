# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local al repositorio (es público).

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Opcional mientras el OTP esté apagado: clave anon o publishable para Auth por correo.
SUPABASE_ANON_KEY=
# "service_role" (secreta). Solo la usa el servidor; nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Firma las cookies de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET=

# Clave compartida del equipo: ingreso en /equipo con uno de los correos autorizados
ADMIN_PASSWORD=

# En espera para el pitch. Solo poner true después de configurar el envío en Supabase.
PARTICIPANT_EMAIL_OTP_ENABLED=false
